# Execution
BROWSER=chromium
HEADLESS=true
TEST_ENV=qa
# BASE_URL=https://zincbank.cydeo.io
DEFAULT_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000
ACTION_TIMEOUT=10000
TRACE=retain-on-failure
SCREENSHOT_ON_FAILURE=true
RECORD_VIDEO=false

# Environment URLs (BASE_URL overrides the selected TEST_ENV URL)
LOCAL_BASE_URL=http://localhost:3000
QA_BASE_URL=https://zincbank.cydeo.io
STAGING_BASE_URL=https://zincbank.cydeo.io
PRODUCTION_BASE_URL=https://zincbank.cydeo.io

# Secrets: copy this file to .env and never commit real values
ZINCBANK_EMAIL=
ZINCBANK_PASSWORD=

# Dedicated resettable account required by @password scenarios
ZINCBANK_PASSWORD_TEST_EMAIL=
ZINCBANK_PASSWORD_TEST_PASSWORD=

# Dedicated resettable account required by profile @mutating scenarios
ZINCBANK_PROFILE_TEST_EMAIL=
ZINCBANK_PROFILE_TEST_PASSWORD=

# Optional seeded fixture values used for exact profile assertions
ZINCBANK_FIRST_NAME=
ZINCBANK_LAST_NAME=
ZINCBANK_PHONE=
ZINCBANK_ADDRESS=
